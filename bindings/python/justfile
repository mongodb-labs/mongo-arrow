docs_build := "docs/_build"
sphinx_opts:= "-d " + docs_build + "/doctrees docs"

# Default target executed when no arguments are given.
[private]
default:
  @just --list

build-libbson:
    uv sync --no-install-project --dev --frozen
    bash build-libbson.sh

build:
    uv sync --dev --reinstall-package pymongoarrow

import-check:
    uv run python -c "from pymongoarrow.lib import libbson_version"

# Build the wheel and verify it imports against both the oldest and the newest
# supported pyarrow.
wheel-import-check:
    #!/usr/bin/env bash
    set -euxo pipefail
    PY=$(command -v python3)
    rm -rf dist
    uv build --wheel --python "$PY"
    WHEEL=$PWD/$(ls dist/pymongoarrow-*.whl)
    # The oldest supported pyarrow is the exact build-time pin.
    FLOOR=$(grep -oE 'pyarrow==[0-9.]+' pyproject.toml | head -1 | cut -d= -f3)
    cd /tmp
    for SPEC in "pyarrow==$FLOOR" ""; do
      VENV=/tmp/pymongoarrow-abi-check
      uv venv --clear -q --python "$PY" "$VENV"
      uv pip install -q --python "$VENV/bin/python" "$WHEEL" $SPEC
      "$VENV/bin/python" -c "from pymongoarrow.lib import libbson_version; import pyarrow; print('import OK with pyarrow', pyarrow.__version__)"
    done

benchmark-install *args:
    rm -rf .venv
    python3 -m venv .venv
    .venv/bin/pip install asv virtualenv
    .venv/bin/pip install -e ".[test,test-polars,test-pandas]"
    .venv/bin/asv machine --yes

benchmark-ci *args:
    [ -f .venv/bin/asv ] || just benchmark-install
    .venv/bin/asv continuous --split --show-stderr --factor 1.3 {{args}}

benchmark *args:
    [ -f .venv/bin/asv ] || just benchmark-install
    .venv/bin/asv run {{args}}

install:
    just build-libbson
    just build
    uv run pre-commit install

test *args:
    uv run --no-dev --extra test --extra test-polars --extra test-pandas pytest {{args}}

test-no-optional *args:
    uv run --no-dev --extra test pytest {{args}}

lint:
    uv sync --no-install-project --dev --frozen
    uv run --no-project pre-commit run --hook-stage manual --all-files

docs:
    uv sync --no-install-project --group docs --frozen
    uv run --no-project sphinx-build -T -b html {{sphinx_opts}} {{docs_build}}/html

docs-serve:
    uv sync --no-install-project --group docs --group dev --frozen
    urn run --no-project sphinx-autobuild --watch ./pymongoarrow docs {{docs_build}}/html

docs-linkcheck *args:
    uv sync --no-install-project --group docs --frozen
    PYTHONHASHSEED=0 uv run --no-project python -m sphinx -q -b linkcheck docs {{docs_build}}/linkcheck {{args}}
