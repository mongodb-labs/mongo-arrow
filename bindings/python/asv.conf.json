{
    "version": 1,
    "project": "pymongoarrow",
    "project_url": "https://mongo-arrow.readthedocs.io/en/latest/",
    "repo": "../../",
    "repo_subdir": "bindings/python",
    "build_command": [
     "python -m pip wheel --no-deps -w {build_cache_dir} {build_dir}"
    ],
    "install_command": [
     "pip install {wheel_file} pandas polars"
    ],
    "branches": ["main"],
    "matrix": {
         "env": {
             "N_DOCS": ["20000", "1000"]
         }
    },
    "environment_type": "virtualenv"
}
